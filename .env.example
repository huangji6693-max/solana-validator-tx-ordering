# Solana Mainnet RPC Endpoint (must support maxSupportedTransactionVersion: 1 post-Alpenglow)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Execution Mode: dry-run by default. Set LIVE_MODE=true or pass --live to broadcast.
DRY_RUN=true

# Hard Fee Spend Cap in Lamports (Default: 50,000,000 lamports = 0.05 SOL)
MAX_SPEND_LAMPORTS=50000000

# Key Isolation: Provide signer key ONLY via external mounted volume path or env var.
# Any path inside the repository working tree is rejected at startup.
SOLANA_KEYPAIR_PATH=/secrets/solana-keypair.json
SOLANA_PRIVATE_KEY=
